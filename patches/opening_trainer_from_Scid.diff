+  ################################################################################
+  # Configuration
+  ################################################################################
+  proc config {} {
+    global tr ::opening::playerBestMove ::opening::opBestMove ::opening::repColor ::opening::maxDepth ::opening::removeGames
+
+    set w .openingConfig
+    if {[winfo exists $w]} {
+      raiseWin $w
+      return
+    }
